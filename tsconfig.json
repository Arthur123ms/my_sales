{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@config/*": ["src/config/*"],
      "@moodules/*": ["src/modules/*"],
      "@shared": ["src/shared/*"],
      "src/*": ["src/*"]
    },
    "rootDir": "./",
    "outDir": "build",

    "module": "commonjs",
    "target": "esnext",
    "types": ["node", "jest"],
    "lib": ["es6", "DOM"],

    "typeRoots": ["node_modules/@types", "src/@types"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "strictPropertyInitialization": false,
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noImplicitAny": true
  },

  "exclude": ["eslint.config.js", "node_modules", "build"]
}
